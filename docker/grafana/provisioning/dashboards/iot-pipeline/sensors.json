      "type": "stat",
      "title": "Temperature",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_bin(INTERVAL '$__interval_ms milliseconds', time) AS time, device_name, avg(value) AS value FROM reading WHERE sensor = 'temperature' AND $__timeFilter(time) AND device_area IN (${area:sqlstring}) AND device_name IN (${device:sqlstring}) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "displayName": "${__field.labels.device_name}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
