          "rawSql": "SELECT device_name AS \"Device\", device_area AS \"Area\", sensor AS \"Sensor\", max(time) AS \"Last reading\", count(*) AS \"Readings\" FROM reading WHERE $__timeFilter(time) AND device_area IN (${area:sqlstring}) AND device_name IN (${device:sqlstring}) GROUP BY 1, 2, 3 ORDER BY 4 DESC, 1, 3"
